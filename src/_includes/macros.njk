{% macro _renderNavListItem(entry) -%}
<li {% if entry.page.url == page.url %}aria-current="page" {% endif %}>
    <a href="{{ entry.page.url }}">{{ entry.data.title }}</a>
</li>
{%- endmacro %}

{% macro renderSidebarCategory(name) -%}
<button class="sidebar-category">{{ name }}</button>
<div class="sidebar-category-content">
    <ul>
        {%- for entry in collections[name] | sortByOrder %}
        {{ _renderNavListItem(entry) }}
        {%- endfor %}
    </ul>
</div>
{%- endmacro %}